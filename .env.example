SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=agro.example.edu.ar
CSRF_TRUSTED_ORIGINS=https://agro.example.edu.ar
DJANGO_SETTINGS_MODULE=config.settings.production

# Docker Compose (docker-compose.yml)
POSTGRES_DB=agroplanner
POSTGRES_USER=agro
POSTGRES_PASSWORD=change-me
# Producción: acceso público mediante HTTPS y backend HTTP privado para el proxy.
# Reemplazar agro.example.edu.ar por el dominio de la facultad.
# Compose construye DATABASE_URL desde POSTGRES_* para su red privada.
SECURE_SSL_REDIRECT=true
# Proxy en este host: 127.0.0.1. Proxy externo: IP privada asignada a este host.
# Restringir el acceso al puerto a través de la red/firewall de la facultad.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000
# Habilitar solo si el proxy reemplaza X-Real-IP y no hay acceso directo al backend.
TRUST_PROXY_CLIENT_IP=false
SOLVER_TIME_LIMIT=300
SOLVER_THREADS=2
MAX_ACTIVE_PLANIFICATIONS=5
